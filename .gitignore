# Local research material: the prior-art paper source, citation snapshots, PDF
# deposit artefacts, and subagent research reports. This directory is kept
# local-only by explicit operator instruction and is never committed.
# Durable findings that matter to a phase are referenced from receipts by
# content hash, not vendored here.
/research/

# Phase-7 coverage-guided fuzzing. `cargo fuzz init`-equivalent source lives in
# `fuzz/` and IS committed (fuzz/Cargo.toml + fuzz/fuzz_targets/ + fuzz/seeds/ +
# fuzz/README.md). Its build outputs, the generated corpus, and crash artifacts
# are never committed.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/campaign/

# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Docker / local environment noise
.DS_Store
*.swp

# Python bytecode from the corpus/schedule/baseline helpers (stdlib only).
__pycache__/
*.pyc

# Evidence campaign scratch (sealed campaigns live under /evidence/campaigns/
# and are committed deliberately; intermediate scratch is ignored).
/evidence/scratch/

# Phase-7 producer corpus: the regenerable PDF bytes are locally generated by
# pinned tools and are NOT committed (no third-party bytes). The build script,
# the provenance ledger, and the measured results ARE committed.
/evidence/corpus/**/*.pdf
/evidence/corpus/**/*.bin
/evidence/corpus/**/.tmp/

# Phase-7.3 partial-materialization corpus: the large regenerable PDF bytes are
# produced by `vole-document pdf-make-large` and are NOT committed. The
# provenance ledger is committed; the bytes are gitignored.
/evidence/corpus/phase7-large/*.pdf

# Phase-7.0b generator-family corpus: same rule for the producers service, plus
# its intermediate generator inputs and LibreOffice profile scratch.
/evidence/corpus/phase7-producers/**/*.html
/evidence/corpus/phase7-producers/**/*.fodt
/evidence/corpus/phase7-producers/**/*.tex
/evidence/corpus/phase7-producers/**/*.aux
/evidence/corpus/phase7-producers/**/*.log
/evidence/corpus/phase7-producers/**/loprofile/

# real100-v1 (real NASA/NIST corpus): redistributable=false rows keep their
# bytes out of the repository and are fetched on demand into this cache. The
# committed corpus lives under real100-v1/documents/ and is not ignored.
/real100-v1/.cache/
/real100-v1/documents/
/real100-v1/pilot/documents/

# realformats-v1 (Phase 21.5.3 FIX 4): pinned real-world multi-format samples
# (XLSX/PPTX/ODS/ODP/JSON/YAML) fetched on demand from stable public sources.
# The manifest (pinned URLs + SHA-256) is committed; the bytes are not.
/realformats-v1/documents/
/realformats-v1/.cache/

# Phase 21.7 CSV: the large generated fixture (regenerated at court time).
/tools/fixtures/csv/large.csv

# Phase 21.8 Markdown: the large generated fixture (regenerated at court time).
/tools/fixtures/markdown/large.md

# Phase 21.7.1 CSV court: a verbatim document-text observation of the ~50 MB
# `large.csv` fixture is tens of MB. The court now writes the *uncapped* dump
# only to gitignored scratch and commits a bounded receipt (text length +
# SHA-256 + a bounded prefix) as `<fixture>.text.json`. Git has no size-based
# ignore, so the "uncapped raw evidence" convention is encoded in the name: any
# artifact whose suffix marks it as a full/verbatim dump carries `.full.json`
# and is never committed. This is the belt-and-suspenders guard against a future
# full dump (e.g. `large.csv.text.full.json`) being committed verbatim.
evidence/**/*.full.json
