# Local research material: the prior-art paper source, citation snapshots, PDF
# deposit artefacts, and subagent research reports. This directory is kept
# local-only by explicit operator instruction and is never committed.
# Durable findings that matter to a phase are referenced from receipts by
# content hash, not vendored here.
/research/

# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Docker / local environment noise
.DS_Store
*.swp

# Evidence campaign scratch (sealed campaigns live under /evidence/campaigns/
# and are committed deliberately; intermediate scratch is ignored).
/evidence/scratch/
