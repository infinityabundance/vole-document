      "status": "measured",
      "switch": "lane a4: features rans,store,field,package,opc (no docx/epub)"
    },
    {
      "note": "progressive semantic inversion (the docx/epub content adapters); \u00a7106 eager-vs-progressive is not separable \u2014 progressive is the only mode (model nodes are registered at ingest and parsed on first materialization)",
      "rung": "A5",
      "status": "measured",
      "switch": "lane a5: features rans,store,field,package,opc,docx,epub with --no-cache"
    },
